# Direct API route. Copy this file to .env and fill only the providers you use.
DIRECT_API_KEY=
DIRECT_API_BASE_URL=https://api.openai.com/v1
DIRECT_API_MODEL=
DIRECT_API_REASONING_EFFORT=medium
DIRECT_API_MAX_INPUT_CHARACTERS=500000
DIRECT_API_MAX_RETRIES=2
DIRECT_API_TIMEOUT_SECONDS=300

# Optional post-research coder. Disabled unless a contract or batch flag uses coder_mode=api.
# This makes one Responses-compatible API call over research_report.md and archived evidence excerpts.
EVIDENCE_CODER_API_KEY=
EVIDENCE_CODER_BASE_URL=https://api.openai.com/v1
EVIDENCE_CODER_MODEL=
EVIDENCE_CODER_REASONING_EFFORT=medium
EVIDENCE_CODER_MAX_INPUT_CHARACTERS=500000
EVIDENCE_CODER_TIMEOUT_SECONDS=300

# Online search and retrieval backends.
# Recommended starter pair: Firecrawl searches; Exa retrieves the selected pages.
FIRECRAWL_API_KEY=
EXA_API_KEY=
SEARCH_API_BACKEND=firecrawl
SEARCH_API_FALLBACKS=exa
WEB_RETRIEVER_BACKEND=exa
WEB_RETRIEVER_FALLBACKS=firecrawl
EXA_RETRIEVE_DELAYS=10,20

# Optional alternative providers.
SERPER_API_KEY=
JINA_API_KEY=

# The canonical reusable web cache is tasks/_global_cache/.
