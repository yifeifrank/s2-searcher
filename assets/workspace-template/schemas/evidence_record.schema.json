{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceRecord",
  "type": "object",
  "required": ["cache_key", "start_line", "end_line", "archived_at", "page_sha256", "source_excerpt", "content_kind"],
  "properties": {
    "cache_key": {"type": "string"},
    "start_line": {"type": "integer", "minimum": 1},
    "end_line": {"type": "integer", "minimum": 1},
    "archived_at": {"type": "string"},
    "page_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_excerpt": {"type": "string"},
    "content_kind": {"enum": ["source_text", "excerpt", "summary"]},
    "exact_quote": {"type": "string", "minLength": 1},
    "quote_fragments": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "summary": {"type": "string"},
    "url": {"type": "string"},
    "source_path": {"type": "string"},
    "title": {"type": "string"},
    "labels": {"type": "array", "items": {"type": "string"}},
    "facts": {"type": "object"},
    "task_summary": {"type": "string"}
  },
  "additionalProperties": true
}

