{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OnlineResearchWorklog",
  "type": "object",
  "required": [
    "contract_version",
    "status",
    "subject",
    "task_id",
    "objective",
    "todo",
    "search_iterations",
    "search_call_count",
    "open_gaps",
    "frozen_pages",
    "frozen_page_count",
    "evidence_count",
    "completed_at"
  ],
  "properties": {
    "contract_version": {"const": "online-research-v1-20260812"},
    "status": {"enum": ["in_progress", "complete"]},
    "subject": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "todo": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "objective", "status", "attempts", "evidence_refs", "notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^T[0-9]{2,}$"},
          "category": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "status": {"enum": ["pending", "in_progress", "complete", "blocked", "not_applicable"]},
          "attempts": {"type": "integer", "minimum": 0, "maximum": 3},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "search_iterations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["iteration", "todo_ids", "query_summary", "outcome", "new_cache_pages", "new_evidence_records"],
        "properties": {
          "iteration": {"type": "integer", "minimum": 1},
          "todo_ids": {"type": "array", "items": {"type": "string"}},
          "query_summary": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "minLength": 1},
          "new_cache_pages": {"type": "integer", "minimum": 0},
          "new_evidence_records": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "search_call_count": {"type": "integer", "minimum": 1},
    "open_gaps": {"type": "array", "items": {"type": "string"}},
    "frozen_pages": {"type": "array", "items": {"type": "string"}},
    "frozen_page_count": {"type": "integer", "minimum": 0},
    "evidence_count": {"type": "integer", "minimum": 0},
    "completed_at": {"type": "string", "minLength": 1},
    "backend_unavailable": {"type": "boolean"}
  },
  "additionalProperties": true
}
